{
  "resourceType": "StructureDefinition",
  "id": "psychotherapy-note",
  "url": "urn:citramac:StructureDefinition:psychotherapy-note",
  "version": "1",
  "name": "CitramacPsychotherapyNote",
  "title": "CITRAMAC psychotherapy progress note",
  "status": "draft",
  "experimental": false,
  "publisher": "CITRAMAC",
  "description": "A signed psychotherapy progress note: the seven output sections of the guided note, signed by the treating clinician, labelled restricted / psychiatry. VERIFY: the LOINC document type (Composition.type is text until confirmed).",
  "fhirVersion": "4.0.1",
  "kind": "resource",
  "abstract": false,
  "type": "Composition",
  "baseDefinition": "http://hl7.org/fhir/StructureDefinition/Composition",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "Composition",
        "path": "Composition",
        "constraint": [
          {
            "key": "psy-note-1",
            "severity": "error",
            "human": "Carries the R (restricted) and PSY (psychiatry) security labels",
            "expression": "meta.security.where(system = 'http://terminology.hl7.org/CodeSystem/v3-Confidentiality' and code = 'R').exists() and meta.security.where(system = 'http://terminology.hl7.org/CodeSystem/v3-ActCode' and code = 'PSY').exists()"
          },
          {
            "key": "psy-note-2",
            "severity": "error",
            "human": "A signed note is final, or amended after signing",
            "expression": "status = 'final' or status = 'amended'"
          },
          {
            "key": "psy-note-3",
            "severity": "error",
            "human": "The Risk & Safety section carries the safety screen",
            "expression": "section.where(code.coding.where(system = 'urn:citramac:codesystem:psy-note-section' and code = 'risk_safety').exists()).entry.exists()"
          },
          {
            "key": "psy-note-4",
            "severity": "error",
            "human": "Each of the seven sections appears once",
            "expression": "section.where(code.coding.code = 'session_information').count() = 1 and section.where(code.coding.code = 'presenting_focus').count() = 1 and section.where(code.coding.code = 'assessment').count() = 1 and section.where(code.coding.code = 'interventions').count() = 1 and section.where(code.coding.code = 'response').count() = 1 and section.where(code.coding.code = 'risk_safety').count() = 1 and section.where(code.coding.code = 'plan').count() = 1"
          }
        ]
      },
      {
        "id": "Composition.meta",
        "path": "Composition.meta",
        "min": 1
      },
      {
        "id": "Composition.meta.security",
        "path": "Composition.meta.security",
        "min": 2
      },
      {
        "id": "Composition.identifier",
        "path": "Composition.identifier",
        "min": 1
      },
      {
        "id": "Composition.type.text",
        "path": "Composition.type.text",
        "min": 1
      },
      {
        "id": "Composition.subject",
        "path": "Composition.subject",
        "min": 1,
        "type": [
          {
            "code": "Reference",
            "targetProfile": [
              "http://hl7.org/fhir/StructureDefinition/Patient"
            ]
          }
        ]
      },
      {
        "id": "Composition.encounter",
        "path": "Composition.encounter",
        "min": 1
      },
      {
        "id": "Composition.author",
        "path": "Composition.author",
        "min": 1,
        "max": "1"
      },
      {
        "id": "Composition.confidentiality",
        "path": "Composition.confidentiality",
        "min": 1,
        "fixedCode": "R"
      },
      {
        "id": "Composition.attester",
        "path": "Composition.attester",
        "min": 1,
        "max": "1"
      },
      {
        "id": "Composition.attester.mode",
        "path": "Composition.attester.mode",
        "fixedCode": "legal"
      },
      {
        "id": "Composition.attester.time",
        "path": "Composition.attester.time",
        "min": 1
      },
      {
        "id": "Composition.attester.party",
        "path": "Composition.attester.party",
        "min": 1
      },
      {
        "id": "Composition.section",
        "path": "Composition.section",
        "min": 7,
        "max": "7"
      },
      {
        "id": "Composition.section.title",
        "path": "Composition.section.title",
        "min": 1
      },
      {
        "id": "Composition.section.code",
        "path": "Composition.section.code",
        "min": 1,
        "binding": {
          "strength": "required",
          "valueSet": "urn:citramac:valueset:psy-note-section"
        }
      },
      {
        "id": "Composition.section.text",
        "path": "Composition.section.text",
        "min": 1
      }
    ]
  }
}
