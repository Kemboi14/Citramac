{
  "resourceType": "StructureDefinition",
  "id": "psychotherapy-safety-screen",
  "url": "urn:citramac:StructureDefinition:psychotherapy-safety-screen",
  "version": "1",
  "name": "CitramacPsychotherapySafetyScreen",
  "title": "CITRAMAC psychotherapy session safety screen",
  "status": "draft",
  "experimental": false,
  "publisher": "CITRAMAC",
  "description": "The answer to the mandatory safety question asked in every psychotherapy session. VERIFY: a LOINC or SNOMED CT code for the question (local code until confirmed).",
  "fhirVersion": "4.0.1",
  "kind": "resource",
  "abstract": false,
  "type": "Observation",
  "baseDefinition": "http://hl7.org/fhir/StructureDefinition/Observation",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "Observation",
        "path": "Observation",
        "constraint": [
          {
            "key": "psy-safety-1",
            "severity": "error",
            "human": "Carries the R (restricted) and PSY (psychiatry) security labels",
            "expression": "meta.security.where(system = 'http://terminology.hl7.org/CodeSystem/v3-Confidentiality' and code = 'R').exists() and meta.security.where(system = 'http://terminology.hl7.org/CodeSystem/v3-ActCode' and code = 'PSY').exists()"
          },
          {
            "key": "psy-safety-2",
            "severity": "error",
            "human": "Concerns are recorded only on a Yes answer",
            "expression": "component.exists() implies value.coding.where(code = 'YES').exists()"
          }
        ]
      },
      {
        "id": "Observation.meta",
        "path": "Observation.meta",
        "min": 1
      },
      {
        "id": "Observation.meta.security",
        "path": "Observation.meta.security",
        "min": 2
      },
      {
        "id": "Observation.status",
        "path": "Observation.status",
        "fixedCode": "final"
      },
      {
        "id": "Observation.code",
        "path": "Observation.code",
        "patternCodeableConcept": {
          "coding": [
            {
              "system": "urn:citramac:codesystem:psy-session-safety",
              "code": "session-safety-question"
            }
          ]
        }
      },
      {
        "id": "Observation.subject",
        "path": "Observation.subject",
        "min": 1,
        "type": [
          {
            "code": "Reference",
            "targetProfile": [
              "http://hl7.org/fhir/StructureDefinition/Patient"
            ]
          }
        ]
      },
      {
        "id": "Observation.encounter",
        "path": "Observation.encounter",
        "min": 1
      },
      {
        "id": "Observation.effective[x]",
        "path": "Observation.effective[x]",
        "min": 1,
        "type": [
          {
            "code": "dateTime"
          }
        ]
      },
      {
        "id": "Observation.performer",
        "path": "Observation.performer",
        "min": 1,
        "max": "1"
      },
      {
        "id": "Observation.value[x]",
        "path": "Observation.value[x]",
        "min": 1,
        "type": [
          {
            "code": "CodeableConcept"
          }
        ],
        "binding": {
          "strength": "required",
          "valueSet": "urn:citramac:valueset:psy-safety-answer"
        }
      },
      {
        "id": "Observation.dataAbsentReason",
        "path": "Observation.dataAbsentReason",
        "max": "0"
      }
    ]
  }
}
