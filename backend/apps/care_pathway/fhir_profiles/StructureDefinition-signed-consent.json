{
  "resourceType": "StructureDefinition",
  "id": "signed-consent",
  "url": "urn:citramac:StructureDefinition:signed-consent",
  "version": "1",
  "status": "draft",
  "experimental": false,
  "publisher": "CITRAMAC",
  "name": "CitramacSignedConsent",
  "title": "CITRAMAC signed consent",
  "description": "A consent given at a mental-health / addiction service: a decision consent or a signed consent document. Signed on screen by the deciding party and the staff witness (see the consent-signature-provenance profile).",
  "fhirVersion": "4.0.1",
  "kind": "resource",
  "abstract": false,
  "type": "Consent",
  "baseDefinition": "http://hl7.org/fhir/StructureDefinition/Consent",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "Consent",
        "path": "Consent",
        "constraint": [
          {
            "key": "sig-con-1",
            "severity": "error",
            "human": "Carries the R (restricted) and PSY (psychiatry) security labels",
            "expression": "meta.security.where(system = 'http://terminology.hl7.org/CodeSystem/v3-Confidentiality' and code = 'R').exists() and meta.security.where(system = 'http://terminology.hl7.org/CodeSystem/v3-ActCode' and code = 'PSY').exists()"
          },
          {
            "key": "sig-con-2",
            "severity": "error",
            "human": "A consent in force names who gave it",
            "expression": "status = 'active' implies performer.exists()"
          },
          {
            "key": "sig-con-3",
            "severity": "error",
            "human": "Recorded, or awaiting a deferred decision",
            "expression": "status = 'active' or status = 'proposed'"
          }
        ]
      },
      {
        "id": "Consent.meta",
        "path": "Consent.meta",
        "min": 1
      },
      {
        "id": "Consent.meta.security",
        "path": "Consent.meta.security",
        "min": 2
      },
      {
        "id": "Consent.patient",
        "path": "Consent.patient",
        "min": 1,
        "type": [
          {
            "code": "Reference",
            "targetProfile": [
              "http://hl7.org/fhir/StructureDefinition/Patient"
            ]
          }
        ]
      },
      {
        "id": "Consent.dateTime",
        "path": "Consent.dateTime",
        "min": 1
      },
      {
        "id": "Consent.policyRule",
        "path": "Consent.policyRule",
        "min": 1
      },
      {
        "id": "Consent.provision",
        "path": "Consent.provision",
        "min": 1
      },
      {
        "id": "Consent.provision.type",
        "path": "Consent.provision.type",
        "min": 1
      }
    ]
  }
}
