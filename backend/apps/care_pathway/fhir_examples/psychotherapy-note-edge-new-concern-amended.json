            "text": {
              "status": "additional",
              "div": "<div xmlns=\"http://www.w3.org/1999/xhtml\">Date: 2026-11-12<br/>Time: 11:50<br/>Duration: 60 minutes<br/>Clinician: Jane Njoroge<br/>Session type: Individual Psychotherapy<br/>Mode: In person<br/>Therapy episode: Cognitive behavioural therapy, session 1 of 8</div>"
