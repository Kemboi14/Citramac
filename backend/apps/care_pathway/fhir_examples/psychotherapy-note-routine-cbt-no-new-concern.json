                  "display": "Session Information"
                }
              ]
            },
            "text": {
              "status": "additional",
              "div": "<div xmlns=\"http://www.w3.org/1999/xhtml\">Date: 2026-11-12<br/>Time: 11:50<br/>Duration: 50 minutes<br/>Clinician: Jane Njoroge<br/>Session type: Individual Psychotherapy<br/>Mode: In person<br/>Therapy episode: Cognitive behavioural therapy, session 1 of 8</div>"
            }
          },
          {
            "title": "Presenting Focus / Client Report",
            "code": {
              "coding": [
                {
                  "system": "urn:citramac:codesystem:psy-note-section",
                  "code": "presenting_focus",
                  "display": "Presenting Focus / Client Report"
                }
              ]
            },
            "text": {
              "status": "additional",
              "div": "<div xmlns=\"http://www.w3.org/1999/xhtml\">Client report:<br/>- Client reported fewer panic episodes since the last session.<br/>- She wanted to work on worry about her end-of-term exams.</div>"
            }
          },
          {
            "title": "Clinical Assessment / Observations",
            "code": {
              "coding": [
                {
                  "system": "urn:citramac:codesystem:psy-note-section",
                  "code": "assessment",
                  "display": "Clinical Assessment / Observations"
                }
              ]
            },
            "text": {
              "status": "additional",
              "div": "<div xmlns=\"http://www.w3.org/1999/xhtml\">Client report:<br/>- Client said she is sleeping about six hours most nights.<br/><br/>Clinician observation / assessment:<br/>- Appeared calmer than last session and maintained good eye contact.</div>"
            }
          },
          {
            "title": "Therapeutic Focus & Interventions",
            "code": {
              "coding": [
                {
                  "system": "urn:citramac:codesystem:psy-note-section",
                  "code": "interventions",
                  "display": "Therapeutic Focus & Interventions"
                }
              ]
            },
            "text": {
              "status": "additional",
              "div": "<div xmlns=\"http://www.w3.org/1999/xhtml\">Approach(es) identified by clinician: CBT<br/><br/>Model-consistent elements documented:<br/>- CBT: Thoughts, restructuring<br/><br/>Session work and interventions:<br/>- Used CBT: reviewed her thought record and practised cognitive restructuring for the thought that she will fail.<br/>- Introduced a worry-time schedule.</div>"
            }
          },
          {
            "title": "Client Response & Progress",
            "code": {
              "coding": [
                {
                  "system": "urn:citramac:codesystem:psy-note-section",
                  "code": "response",
                  "display": "Client Response & Progress"
                }
              ]
            },
            "text": {
              "status": "additional",
              "div": "<div xmlns=\"http://www.w3.org/1999/xhtml\">Client response as observed:<br/>- Client identified two alternative thoughts and rated her anxiety lower after the exercise.<br/><br/>Client reported:<br/>- She said the thought record was helpful.<br/><br/>Change since the previous score (clinician decided):<br/>- GAD-7 15 (Severe) on 2026-10-29, then 5 (Mild) on 2026-11-12: Improved 10 points · reliable change · clinically significant (now below 8). Clinician: improvement noted.<br/><br/>Measurement:<br/>- GAD-7 total 5 (recorded through the outcome store)</div>"
            }
          },
          {
            "title": "Risk & Safety",
            "code": {
              "coding": [
                {
                  "system": "urn:citramac:codesystem:psy-note-section",
                  "code": "risk_safety",
                  "display": "Risk & Safety"
                }
              ]
            },
            "text": {
              "status": "additional",
              "div": "<div xmlns=\"http://www.w3.org/1999/xhtml\">No new or changed safety concern identified based on today&#x27;s assessment.</div>"
            },
            "entry": [
              {
                "reference": "urn:uuid:b043a985-a5be-543e-9df2-96d1407e6d6a"
              }
            ]
          },
          {
            "title": "Plan",
            "code": {
              "coding": [
                {
                  "system": "urn:citramac:codesystem:psy-note-section",
                  "code": "plan",
                  "display": "Plan"
                }
              ]
            },
            "text": {
              "status": "additional",
              "div": "<div xmlns=\"http://www.w3.org/1999/xhtml\">Next steps:<br/>- Continue the thought record daily and try worry time each evening.<br/>- Next session in one week.</div>"
            }
          }
        ]
      }
