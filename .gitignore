# Environment / secrets
.env
*.env.local
# Note: .secrets.baseline IS committed (detect-secrets tracks reviewed false positives, not real secrets).

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
db.sqlite3
staticfiles/
mediafiles/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / frontend
node_modules/
dist/
frontend/.vite/

# Editors / OS
.vscode/
.idea/
.DS_Store

# Terraform
**/.terraform/
*.tfstate
*.tfstate.backup
*.tfvars
# .terraform.lock.hcl is deliberately NOT ignored — Terraform's own
# convention is to commit it so every `terraform init` resolves the exact
# same provider versions (docs/12-DEVOPS-DEPLOYMENT.md §12.4).
