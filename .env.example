# Copy to .env and fill in real values for local development.
# Never commit the real .env file — see docs/09-SECURITY-COMPLIANCE.md §9.1.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-random-value
DJANGO_DEBUG=True
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change-me-to-a-generated-fernet-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (docker-compose 'postgres' service) ---
DATABASE_URL=postgres://citramac:citramac@postgres:5432/citramac
POSTGRES_DB=citramac
POSTGRES_USER=citramac
POSTGRES_PASSWORD=citramac

# --- Redis / Celery (docker-compose 'redis' service) ---
REDIS_URL=redis://redis:6379/0

# --- Email / OTP dispatch (docker-compose 'mailhog' service, docs/05-AUTHENTICATION-FLOW.md) ---
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=no-reply@citramac.local

# --- SMS / OTP + appointment reminders (Onfon Media, apps/notifications/sms.py) ---
# Platform-wide fallback gateway credentials — leave blank in dev, SMS sends
# just log a stub event. Each tenant can also set its own under Org Admin's
# Branch Settings > SMS Configuration (or Super Admin's SMS Settings page
# sets these same platform-wide defaults instead of env vars).
ONFON_SENDER_ID=
ONFON_CLIENT_ID=
ONFON_ACCESS_KEY=
ONFON_API_KEY=

# --- DHA Health Information Exchange (registries, SHA claims, Shared Health Record) ---
# Fallback only: Super Admin normally saves these under DHA / SHA Integration.
# UAT base URL (printed in DHA's published specs):
#   https://ilm-dev.dha.go.ke/uat-middleware/api/v1
# Production base URL is issued by DHA at onboarding. Leave blank in dev — every
# HIE call then reports "not configured".
HIE_API_BASE_URL=
HIE_API_CLIENT_ID=
HIE_API_CLIENT_SECRET=
# Comma-separated eligibility coverage.status values that mean active cover.
# DHA publishes no vocabulary — set only from a confirmed UAT response.
SHA_ACTIVE_COVERAGE_STATUSES=

# --- CORS (frontend dev server) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend public origin (used to build links in emails, e.g. activation) ---
FRONTEND_URL=http://localhost:5173

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
